// checkJs for the JavaScript that stays JavaScript (v3 Phase 2, step 10): scripts, evals, and test keep their .js
// names (deploy.sh, compose.yml, and the Windows tasks run scripts/*.js by name) and are typed with JSDoc. Every
// directory passes now; the root config turns checkJs on and this file goes in the close-out.
{
  "extends": "./tsconfig.json",
  "compilerOptions": { "checkJs": true },
  "include": ["evals", "scripts", "types", "test"]
}
