{
  "name": "job-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "config:from-v1": "node scripts/config-from-v1.js",
    "check:personal": "node scripts/check-personal.js",
    "hooks:install": "git config core.hooksPath .githooks",
    "google:login": "node --env-file=.env scripts/google-login.js",
    "google:check": "node --env-file=.env scripts/google-check.js",
    "import:v1": "node --env-file=.env scripts/import-v1.js",
    "discover": "node --env-file=.env scripts/discover.js",
    "score": "node --env-file=.env scripts/score.js",
    "eval:score": "node --env-file=.env scripts/eval-score.js",
    "hunt": "node --env-file=.env scripts/hunt.js",
    "archive": "node scripts/archive.js",
    "cleanup": "node scripts/cleanup.js",
    "report": "node --env-file=.env scripts/report.js",
    "pipeline": "node --env-file=.env scripts/pipeline.js",
    "web:build": "vite build",
    "web:dev": "vite",
    "ui": "vite build && node --env-file=.env server/index.js",
    "add": "node --env-file=.env scripts/add.js",
    "inbox:auth": "node --env-file-if-exists=.env scripts/inbox-auth.js",
    "inbox": "node --env-file=.env scripts/inbox.js",
    "inbox:backfill": "node --env-file=.env scripts/inbox.js --backfill"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Job discovery and job hunt agents",
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@fastify/swagger": "^9.9.1",
    "@googleapis/docs": "^14.0.1",
    "@googleapis/drive": "^26.0.1",
    "@googleapis/gmail": "^22.0.1",
    "@scottmroth5/agent-core": "github:scottmroth5/Agent-Core#semver:^0.2.0",
    "csv-parse": "^7.0.3",
    "fastify": "^5.12.5",
    "google-auth-library": "^11.1.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.1"
  }
}