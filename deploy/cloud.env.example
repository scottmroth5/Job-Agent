# The cloud server's settings: copy your local .env to /opt/job-agent/.env, then add or change these lines.
# The file stays on the server only (chmod 600, owned by the deploy user). Never commit it or put it in GitHub.
# compose.yml already fixes DATA_DIR=/data, HOST=0.0.0.0, PORT=5178, and TRUST_PROXY (Caddy on the private network) for the container.

# The public address Caddy serves and gets a certificate for (no https://, no path).
SITE_ADDRESS=jobs.example.com
# The public, read-only demo on sample data (its own DNS record pointing at this server).
DEMO_SITE_ADDRESS=demojobs.example.com

# Google sign-in. The server refuses to start without all five, or without an https PUBLIC_URL.
AUTH_MODE=google
PUBLIC_URL=https://jobs.example.com
# Your own Google addresses: they are the owner. Anyone else signs in and requests access (Admin > Users).
AUTH_ALLOWED_EMAILS=you@example.com
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
# npm run auth:setup prints a fresh one; use a new secret for the server rather than the local one.
SESSION_SECRET=
# Encrypts the Claude keys users save in Settings (tools/secret-box.js). At least 32 characters; set it once and keep
# it (and in your password manager): changing or losing it makes every saved key unreadable, so users must re-enter them.
USER_KEY_SECRET=

# Calendar days and the schedule run in this zone (IANA name). Copy the TZ line from your local .env.
TZ=America/Chicago

# The in-app scheduler replaces the Windows tasks. Leave these off until cutover (step 2 of the plan),
# and turn the Windows tasks off at the same time: never run both.
#SCHEDULE_PIPELINE=Mon,Thu 06:00
#SCHEDULE_BACKUP=daily 23:00

# Optional: a different image (a fork) instead of ghcr.io/scottmroth5/job-agent.
#IMAGE=ghcr.io/<owner>/job-agent
